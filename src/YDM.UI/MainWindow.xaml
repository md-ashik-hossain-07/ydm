<Window x:Class="YDM.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:YDM.UI.ViewModels"
        mc:Ignorable="d"
        Title="YDM — Your Download Manager" 
        Height="730" Width="1220"
        MinHeight="540" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" 
                      ResizeBorderThickness="6" 
                      CornerRadius="10" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Top Action Button Style -->
        <Style x:Key="ActionToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Prominent Add URL Button Style -->
        <Style x:Key="AddUrlButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionToolbarButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Title Bar Control Button Style -->
        <Style x:Key="WindowCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowCaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card In-Line Action Button Style -->
        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Context Menu -->
        <ContextMenu x:Key="CardItemContextMenu">
            <MenuItem Header="📁 Open File" Command="{Binding DataContext.OpenFileItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
            <MenuItem Header="📂 Open Folder" Command="{Binding DataContext.OpenFolderItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="▶ Resume Download" Command="{Binding DataContext.ResumeItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
            <MenuItem Header="⏸ Pause Download" Command="{Binding DataContext.PauseItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
            <MenuItem Header="⏹ Stop Download" Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="🔗 Copy Source URL" Command="{Binding DataContext.CopyUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <MenuItem Header="🗑 Remove from List" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
        </ContextMenu>
    </Window.Resources>

    <!-- Outer Window Border with Rounded Corners -->
    <Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/> <!-- Top Title Bar -->
                <RowDefinition Height="52"/> <!-- Top Action Toolbar -->
                <RowDefinition Height="*"/>  <!-- Main Three-Pane Layout -->
                <RowDefinition Height="34"/> <!-- Bottom Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. TOP TITLE BAR -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="True" Margin="14,0,8,0">
                    <!-- Left: 3 Window Accent Dots + Brand Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <Ellipse Width="11" Height="11" Fill="#EF4444" Margin="0,0,6,0" ToolTip="Close"/>
                        <Ellipse Width="11" Height="11" Fill="#F59E0B" Margin="0,0,6,0" ToolTip="Minimize"/>
                        <Ellipse Width="11" Height="11" Fill="#10B981" Margin="0,0,14,0" ToolTip="Maximize"/>

                        <!-- Cloud Brand Badge -->
                        <Border Width="26" Height="26" Background="#2563EB" CornerRadius="6" Margin="0,0,8,0">
                            <TextBlock Text="☁" Foreground="#FFFFFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="YDM — Your Download Manager" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   VerticalAlignment="Center" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Right: View Toggle, Theme Switch, and Standard Window Controls -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                        <!-- Grid / List View Toggle Group -->
                        <Border Background="{DynamicResource SearchBoxBackgroundBrush}" 
                                BorderBrush="{DynamicResource BorderColorBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="2" 
                                Margin="0,0,10,0" 
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <Button Width="28" Height="24" 
                                        Command="{Binding SetGridViewCommand}" 
                                        ToolTip="Card / Grid View" 
                                        BorderThickness="0" 
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="⊞" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Width="28" Height="24" 
                                        Command="{Binding SetListViewCommand}" 
                                        ToolTip="Compact List View" 
                                        BorderThickness="0" 
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="☰" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Theme Toggle Switch Pill -->
                        <Button Command="{Binding ToggleThemeCommand}" 
                                ToolTip="Toggle Light / Dark Mode" 
                                Width="52" Height="26" 
                                Margin="0,0,14,0" 
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource SearchBoxBackgroundBrush}" 
                                            BorderBrush="{DynamicResource BorderColorBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="13" 
                                            Padding="4,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🌙" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="☀️" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Windows Native Controls (Minimize, Maximize, Close) -->
                        <Button Content="—" Style="{StaticResource WindowCaptionButtonStyle}" Click="Minimize_Click" ToolTip="Minimize"/>
                        <Button Content="▢" Style="{StaticResource WindowCaptionButtonStyle}" Click="Maximize_Click" ToolTip="Maximize"/>
                        <Button Content="✕" Style="{StaticResource WindowCloseCaptionButtonStyle}" Click="Close_Click" ToolTip="Close"/>
                    </StackPanel>

                    <!-- Center: Rounded Search Downloads Pill -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Background="{DynamicResource SearchBoxBackgroundBrush}" 
                                BorderBrush="{DynamicResource BorderColorBrush}" 
                                BorderThickness="1" 
                                CornerRadius="16" 
                                Height="30" 
                                Padding="10,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" 
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         BorderThickness="0" 
                                         Background="Transparent" 
                                         Foreground="{DynamicResource TextPrimaryBrush}" 
                                         FontSize="12" 
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="1" 
                                           Text="Search downloads..." 
                                           FontSize="12" 
                                           Foreground="{DynamicResource TextMutedBrush}" 
                                           VerticalAlignment="Center" 
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 2. TOP ACTION TOOLBAR -->
            <Border Grid.Row="1" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                <DockPanel LastChildFill="False">
                    <!-- Left Toolbar Buttons -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <!-- Primary Blue Add URL Button -->
                        <Button Style="{StaticResource AddUrlButtonStyle}" Click="AddUrl_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add URL" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="8,4" Width="1" Background="{DynamicResource BorderColorBrush}"/>

                        <!-- Resume -->
                        <Button Style="{StaticResource ActionToolbarButtonStyle}" Command="{Binding ResumeDownloadCommand}" ToolTip="Resume selected download">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" Foreground="#10B981" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Resume" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Pause -->
                        <Button Style="{StaticResource ActionToolbarButtonStyle}" Command="{Binding PauseDownloadCommand}" ToolTip="Pause selected download">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏸" Foreground="#F59E0B" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Pause" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Stop -->
                        <Button Style="{StaticResource ActionToolbarButtonStyle}" Command="{Binding CancelDownloadCommand}" ToolTip="Stop selected download">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="■" Foreground="#EF4444" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Stop" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Remove -->
                        <Button Style="{StaticResource ActionToolbarButtonStyle}" Command="{Binding RemoveDownloadCommand}" ToolTip="Remove selected download">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" Foreground="#EF4444" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Remove" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Open Folder -->
                        <Button Style="{StaticResource ActionToolbarButtonStyle}" Command="{Binding OpenFolderCommand}" ToolTip="Open containing folder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" Foreground="#F59E0B" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open Folder" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Overflow Actions Menu -->
                        <Button Style="{StaticResource ActionToolbarButtonStyle}" Width="36" Click="OverflowMenu_Click" ToolTip="More actions">
                            <TextBlock Text="···" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="▶ Start Queue" Command="{Binding StartQueueCommand}"/>
                                    <MenuItem Header="⏸ Pause Queue" Command="{Binding StopQueueCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="🧹 Clear Completed History" Command="{Binding ClearCompletedHistoryCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="🔗 Copy Source URL" Command="{Binding CopyUrlCommand}"/>
                                    <MenuItem Header="📂 Copy Save Location" Command="{Binding CopySaveLocationCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <!-- Right Toolbar Buttons (Settings) -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ActionToolbarButtonStyle}" Click="OpenSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Foreground="#2563EB" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 3. MAIN THREE-PANE BODY -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- Left Sidebar -->
                    <ColumnDefinition Width="210" MinWidth="180" MaxWidth="280"/>
                    <!-- Center Downloads Area -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right Details Panel -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 3A. LEFT SIDEBAR NAVIGATION -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,12">
                            <!-- All Downloads -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Click="Category_Click" Tag="All">
                                <Border CornerRadius="8" Padding="10,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategory}" Value="All">
                                                    <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSubtleBorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SidebarBadgeBackgroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="All">
                                                            <Setter Property="Background" Value="{DynamicResource SidebarActiveBadgeBackgroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TotalCount}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SidebarBadgeTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedCategory}" Value="All">
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="22" Height="22" Background="#2563EB" CornerRadius="5" Margin="0,0,8,0">
                                                <TextBlock Text="☁" Foreground="#FFFFFF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="All Downloads" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>

                            <!-- Downloading -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Click="Category_Click" Tag="Downloading">
                                <Border CornerRadius="8" Padding="10,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Downloading">
                                                    <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSubtleBorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource SidebarBadgeBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DownloadingCount}" FontSize="11" Foreground="{DynamicResource SidebarBadgeTextBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⬇" Foreground="#2563EB" FontSize="13" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Downloading" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>

                            <!-- Completed -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Click="Category_Click" Tag="Completed">
                                <Border CornerRadius="8" Padding="10,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Completed">
                                                    <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSubtleBorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource SidebarBadgeBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CompletedCount}" FontSize="11" Foreground="{DynamicResource SidebarBadgeTextBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="✔" Foreground="#10B981" FontSize="12" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Completed" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>

                            <!-- Paused -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Click="Category_Click" Tag="Paused">
                                <Border CornerRadius="8" Padding="10,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Paused">
                                                    <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSubtleBorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource SidebarBadgeBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PausedCount}" FontSize="11" Foreground="{DynamicResource SidebarBadgeTextBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⏸" Foreground="#F59E0B" FontSize="11" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Paused" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>

                            <!-- Failed -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Click="Category_Click" Tag="Failed">
                                <Border CornerRadius="8" Padding="10,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Failed">
                                                    <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSubtleBorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource SidebarBadgeBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FailedCount}" FontSize="11" Foreground="{DynamicResource SidebarBadgeTextBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="✖" Foreground="#EF4444" FontSize="11" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Failed" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>

                            <!-- Separator -->
                            <Separator Margin="4,12" Background="{DynamicResource BorderColorBrush}"/>

                            <!-- Categories Header -->
                            <TextBlock Text="Categories" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,6"/>

                            <!-- All Categories -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Click="Category_Click" Tag="All">
                                <Border CornerRadius="8" Padding="10,8">
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource SidebarBadgeBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AllCategoriesCount}" FontSize="11" Foreground="{DynamicResource SidebarBadgeTextBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="☁" Foreground="#2563EB" FontSize="12" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="All Categories" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>

                            <!-- Documents -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Click="Category_Click" Tag="Documents">
                                <Border CornerRadius="8" Padding="10,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Documents">
                                                    <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSubtleBorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource SidebarBadgeBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DocumentsCount}" FontSize="11" Foreground="{DynamicResource SidebarBadgeTextBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📄" Foreground="#0EA5E9" FontSize="12" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Documents" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>

                            <!-- Compressed -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Click="Category_Click" Tag="Compressed">
                                <Border CornerRadius="8" Padding="10,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Compressed">
                                                    <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSubtleBorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource SidebarBadgeBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CompressedCount}" FontSize="11" Foreground="{DynamicResource SidebarBadgeTextBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🗜" Foreground="#F59E0B" FontSize="12" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Compressed" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>

                            <!-- Video -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Click="Category_Click" Tag="Video">
                                <Border CornerRadius="8" Padding="10,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Video">
                                                    <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSubtleBorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource SidebarBadgeBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VideoCount}" FontSize="11" Foreground="{DynamicResource SidebarBadgeTextBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎬" Foreground="#8B5CF6" FontSize="12" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Video" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>

                            <!-- Music -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Click="Category_Click" Tag="Music">
                                <Border CornerRadius="8" Padding="10,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Music">
                                                    <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSubtleBorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource SidebarBadgeBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MusicCount}" FontSize="11" Foreground="{DynamicResource SidebarBadgeTextBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎵" Foreground="#3B82F6" FontSize="12" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Music" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>

                            <!-- Programs -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Click="Category_Click" Tag="Programs">
                                <Border CornerRadius="8" Padding="10,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Programs">
                                                    <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSubtleBorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource SidebarBadgeBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProgramsCount}" FontSize="11" Foreground="{DynamicResource SidebarBadgeTextBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="💻" Foreground="#6366F1" FontSize="12" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Programs" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>

                            <!-- Others -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Click="Category_Click" Tag="Others">
                                <Border CornerRadius="8" Padding="10,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Others">
                                                    <Setter Property="Background" Value="{DynamicResource SidebarActiveBackgroundBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSubtleBorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource SidebarBadgeBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OthersCount}" FontSize="11" Foreground="{DynamicResource SidebarBadgeTextBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📁" Foreground="#F59E0B" FontSize="12" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Others" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 3B. CENTER DOWNLOADS DISPLAY AREA -->
                <Grid Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Controls Header -->
                        <RowDefinition Height="*"/>    <!-- Cards / List View -->
                    </Grid.RowDefinitions>

                    <!-- Header Row: Category Title & Sort/View Controls -->
                    <DockPanel Grid.Row="0" Margin="18,14,18,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" 
                                   Text="{Binding CurrentCategoryTitle}" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center"/>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Sort Dropdown -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Sort: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <ComboBox SelectedValue="{Binding SortOption, Mode=TwoWay}" 
                                          Width="110" Height="28" 
                                          FontSize="12" 
                                          SelectedValuePath="Content"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Date Added" IsSelected="True"/>
                                    <ComboBoxItem Content="Name"/>
                                    <ComboBoxItem Content="Size"/>
                                    <ComboBoxItem Content="Status"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Grid/List Switcher -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" 
                                    BorderBrush="{DynamicResource BorderColorBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Width="26" Height="24" Command="{Binding SetListViewCommand}" ToolTip="List View" BorderThickness="0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="☰" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Width="26" Height="24" Command="{Binding SetGridViewCommand}" ToolTip="Grid / Card View" BorderThickness="0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="⊞" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Main View Content -->
                    <Grid Grid.Row="1" Margin="18,0,18,12">
                        <!-- Empty State Illustration -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Downloads.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="📥" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="No downloads yet" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click '+ Add URL' above or use the browser extension to start downloading." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Primary Card View using ListBox with Cards Template -->
                        <ListBox ItemsSource="{Binding FilteredDownloads}"
                                 SelectedItem="{Binding SelectedDownload, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="CardBorder" 
                                                        Padding="14,12" 
                                                        Background="{DynamicResource CardBackgroundBrush}" 
                                                        BorderBrush="{DynamicResource BorderColorBrush}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="12" 
                                                        Cursor="Hand"
                                                        ContextMenu="{StaticResource CardItemContextMenu}">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" Opacity="0.04" ShadowDepth="1" Direction="270"/>
                                                    </Border.Effect>
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/> <!-- File Badge / Thumbnail -->
                                            <ColumnDefinition Width="*"/>  <!-- Details & Progress -->
                                            <ColumnDefinition Width="Auto"/><!-- Actions -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: 56x56 File Type Badge -->
                                        <Grid Grid.Column="0" Width="54" Height="54" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <!-- Optional Local Image Thumbnail -->
                                            <Border CornerRadius="10" ClipToBounds="True">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Thumbnail, Converter={x:Null}}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Border>

                                            <!-- PDF Badge -->
                                            <Border CornerRadius="10" Background="{DynamicResource BadgePdfBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding BadgeType}" Value="PDF"/>
                                                                    <Condition Binding="{Binding Thumbnail}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="📄" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="PDF" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Video Badge -->
                                            <Border CornerRadius="10" Background="#1E293B">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding BadgeType}" Value="VIDEO"/>
                                                                    <Condition Binding="{Binding Thumbnail}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <TextBlock Text="🎬" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                                    <Border Background="#334155" CornerRadius="4" Padding="3,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3">
                                                        <TextBlock Text="{Binding FileExtension}" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- ZIP / Archive Badge -->
                                            <Border CornerRadius="10" Background="{DynamicResource BadgeZipBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding BadgeType}" Value="ZIP"/>
                                                                    <Condition Binding="{Binding Thumbnail}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🗜" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="ZIP" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Programs / EXE Badge -->
                                            <Border CornerRadius="10" Background="{DynamicResource BadgeExeBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding BadgeType}" Value="EXE"/>
                                                                    <Condition Binding="{Binding Thumbnail}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="⚙" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="EXE" FontWeight="Bold" FontSize="9" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Generic Other File Badge -->
                                            <Border CornerRadius="10" Background="{DynamicResource BadgeGenericBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding BadgeType}" Value="OTHER"/>
                                                                    <Condition Binding="{Binding Thumbnail}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding BadgeType}" Value="DOC"/>
                                                                    <Condition Binding="{Binding Thumbnail}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding BadgeType}" Value="AUDIO"/>
                                                                    <Condition Binding="{Binding Thumbnail}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="📄" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FileExtension}" FontWeight="Bold" FontSize="8" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Middle: Card Content & Progress -->
                                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                            <!-- Filename -->
                                            <TextBlock Text="{Binding FileName}" 
                                                       FontWeight="Bold" 
                                                       FontSize="14" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- Size • Category -->
                                            <TextBlock Text="{Binding SizeAndCategoryFormatted}" 
                                                       FontSize="12" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                                       Margin="0,2,0,6"/>

                                            <!-- Progress Bar with Percentage -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Progress Bar -->
                                                <ProgressBar Grid.Column="0" 
                                                             Height="6" 
                                                             Minimum="0" Maximum="100" 
                                                             Value="{Binding ProgressPercentage, Mode=OneWay}" 
                                                             Background="{DynamicResource ProgressBackgroundBrush}" 
                                                             VerticalAlignment="Center">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar">
                                                            <Setter Property="Foreground" Value="{DynamicResource ProgressActiveBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ProgressCompletedBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>

                                                <!-- Percentage Text -->
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" 
                                                           FontWeight="Bold" 
                                                           FontSize="11" 
                                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                                           Margin="8,0,0,0" 
                                                           VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Status line with metadata -->
                                            <TextBlock Text="{Binding StatusDetailsFormatted}" 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- Right: Action Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Actions for Completed Download -->
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Style="{StaticResource CardActionButtonStyle}" 
                                                        Command="{Binding DataContext.OpenFolderItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}" 
                                                        ToolTip="Open Containing Folder">
                                                    <TextBlock Text="📁" Foreground="#2563EB" FontSize="13"/>
                                                </Button>
                                                <Button Style="{StaticResource CardActionButtonStyle}" 
                                                        Command="{Binding DataContext.OpenFileItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}" 
                                                        ToolTip="Open File">
                                                    <TextBlock Text="↗" Foreground="#2563EB" FontWeight="Bold" FontSize="13"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Actions for Active / Downloading -->
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Style="{StaticResource CardActionButtonStyle}" 
                                                        Command="{Binding DataContext.PauseItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}" 
                                                        ToolTip="Pause Download">
                                                    <TextBlock Text="⏸" Foreground="#F59E0B" FontSize="12"/>
                                                </Button>
                                                <Button Style="{StaticResource CardActionButtonStyle}" 
                                                        Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}" 
                                                        ToolTip="Stop Download">
                                                    <TextBlock Text="■" Foreground="#EF4444" FontSize="12"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Actions for Paused / Queued -->
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPausedOrQueued}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Style="{StaticResource CardActionButtonStyle}" 
                                                        Command="{Binding DataContext.ResumeItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}" 
                                                        ToolTip="Resume Download">
                                                    <TextBlock Text="▶" Foreground="#2563EB" FontSize="12"/>
                                                </Button>
                                                <Button Style="{StaticResource CardActionButtonStyle}" 
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}" 
                                                        ToolTip="Remove Download">
                                                    <TextBlock Text="🗑" Foreground="#EF4444" FontSize="12"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Actions for Failed -->
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Style="{StaticResource CardActionButtonStyle}" 
                                                        Command="{Binding DataContext.ResumeItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}" 
                                                        ToolTip="Retry Download">
                                                    <TextBlock Text="🔄" Foreground="#2563EB" FontSize="12"/>
                                                </Button>
                                                <Button Style="{StaticResource CardActionButtonStyle}" 
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}" 
                                                        ToolTip="Remove Download">
                                                    <TextBlock Text="🗑" Foreground="#EF4444" FontSize="12"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Card More (···) Menu Button -->
                                            <Button Style="{StaticResource CardActionButtonStyle}" 
                                                    Click="OverflowMenu_Click" 
                                                    ToolTip="More Options">
                                                <TextBlock Text="···" FontSize="14" FontWeight="Bold" Margin="0,-2,0,0"/>
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="📁 Open File" Command="{Binding DataContext.OpenFileItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="📂 Open Folder" Command="{Binding DataContext.OpenFolderItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="🔗 Copy Source URL" Command="{Binding DataContext.CopyUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <MenuItem Header="🗑 Delete Download" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Secondary Compact List View -->
                        <DataGrid ItemsSource="{Binding FilteredDownloads}"
                                  SelectedItem="{Binding SelectedDownload, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  RowHeight="38"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource BorderColorBrush}">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="250">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Category" Binding="{Binding CategoryDisplayName}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Setter Property="Margin" Value="6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Progress" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,0" VerticalAlignment="Center">
                                                <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" Height="12" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                           FontSize="9" FontWeight="Bold"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Speed" Binding="{Binding SpeedFormatted}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Status" Binding="{Binding StatusFormatted}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="6,0"/>
                                            <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <!-- 3C. RIGHT-SIDE FILE DETAILS PANEL -->
                <Border Grid.Column="2" 
                        Width="320" 
                        Background="{DynamicResource DetailsPanelBackgroundBrush}" 
                        BorderBrush="{DynamicResource BorderColorBrush}" 
                        BorderThickness="1,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedDownload}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid Margin="18,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header with Badge, Name & Close -->
                            <RowDefinition Height="Auto"/> <!-- Details / Preview / Activity Tabs -->
                            <RowDefinition Height="*"/>    <!-- Tab Content -->
                            <RowDefinition Height="Auto"/> <!-- Open File & Open Folder Buttons -->
                            <RowDefinition Height="Auto"/> <!-- Bottom Quick Icon Bar -->
                        </Grid.RowDefinitions>

                        <!-- Top Header -->
                        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">
                            <!-- Close Button on top right -->
                            <Button DockPanel.Dock="Right" 
                                    Command="{Binding CloseDetailsPanelCommand}" 
                                    Width="26" Height="26" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Cursor="Hand" 
                                    VerticalAlignment="Top" 
                                    ToolTip="Close details">
                                <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>

                            <!-- Large File Badge -->
                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource BadgePdfBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📄" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedDownload.FileExtension}" FontWeight="Bold" FontSize="8" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Name & Status Pill -->
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDownload.FileName}" 
                                           FontWeight="Bold" 
                                           FontSize="15" 
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           TextTrimming="CharacterEllipsis"/>
                                
                                <!-- Status Pill -->
                                <Border CornerRadius="10" Padding="8,2" Margin="0,4,0,0" HorizontalAlignment="Left" Background="{DynamicResource SuccessPillBackgroundBrush}">
                                    <TextBlock Text="{Binding SelectedDownload.StatusFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessPillTextBrush}"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <!-- Tabs: Details, Preview, Activity -->
                        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Details" 
                                        Click="DetailTab_Click" Tag="Details" 
                                        Background="Transparent" BorderThickness="0" 
                                        FontSize="12" 
                                        Padding="10,6" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDetailTab}" Value="Details">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Preview" 
                                        Click="DetailTab_Click" Tag="Preview" 
                                        Background="Transparent" BorderThickness="0" 
                                        FontSize="12" 
                                        Padding="10,6" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDetailTab}" Value="Preview">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Activity" 
                                        Click="DetailTab_Click" Tag="Activity" 
                                        Background="Transparent" BorderThickness="0" 
                                        FontSize="12" 
                                        Padding="10,6" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDetailTab}" Value="Activity">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Tab 1: Details Key-Value Fields -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDetailTab}" Value="Details">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="0,0,4,0">
                                <!-- File Name -->
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="File Name" Width="100" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedDownload.FileName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <!-- File Size -->
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="File Size" Width="100" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedDownload.FileSizeBytesFormatted}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                </DockPanel>

                                <!-- Downloaded -->
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Downloaded" Width="100" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedDownload.DownloadedBytesFormatted}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                </DockPanel>

                                <!-- Save Location -->
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Save Location" Width="100" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <Button DockPanel.Dock="Right" Command="{Binding CopySaveLocationCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Copy folder path">
                                        <TextBlock Text="⧉" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                                    </Button>
                                    <TextBlock Text="{Binding SelectedDownload.SaveLocationFormatted}" Foreground="{DynamicResource AccentBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <!-- Date Added -->
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Date Added" Width="100" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedDownload.DateAddedFormatted}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                </DockPanel>

                                <!-- Completed -->
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Completed" Width="100" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedDownload.CompletedDateFormatted}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                </DockPanel>

                                <!-- Source URL -->
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Source URL" Width="100" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <Button DockPanel.Dock="Right" Command="{Binding CopyUrlCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Copy download URL">
                                        <TextBlock Text="⧉" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                                    </Button>
                                    <TextBlock Text="{Binding SelectedDownload.Url}" Foreground="{DynamicResource AccentBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <!-- Status -->
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Status" Width="100" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedDownload.StatusFormatted, StringFormat='✔ {0}'}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="12"/>
                                </DockPanel>

                                <!-- Category -->
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Category" Width="100" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedDownload.CategoryDisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                </DockPanel>

                                <!-- Resume Support -->
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Resume Support" Width="100" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedDownload.ResumeSupportFormatted}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                </DockPanel>

                                <!-- Comment -->
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Comment" Width="100" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="—" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                </DockPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Tab 2: Preview Content -->
                        <Border Grid.Row="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDetailTab}" Value="Preview">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="120" Height="120" CornerRadius="10" Background="{DynamicResource SearchBoxBackgroundBrush}" ClipToBounds="True" Margin="0,0,0,10">
                                    <Grid>
                                        <Image Source="{Binding SelectedDownload.Thumbnail}" Stretch="UniformToFill"/>
                                        <TextBlock Text="👁" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedDownload.Thumbnail}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding SelectedDownload.FileName}" FontWeight="Bold" FontSize="13" TextAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding SelectedDownload.FormattedTotalSize}" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tab 3: Activity & Segments Content -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDetailTab}" Value="Activity">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Download Segments" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding SelectedDownload.Segments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="8,6" Background="{DynamicResource SearchBoxBackgroundBrush}" CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='Part #{0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                                                    <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Primary Buttons: Open File and Open Folder -->
                        <Grid Grid.Row="3" Margin="0,14,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Open File (Primary Blue) -->
                            <Button Grid.Column="0" 
                                    Command="{Binding OpenFileCommand}" 
                                    Height="36" 
                                    Margin="0,0,4,0" 
                                    Background="{DynamicResource AccentBrush}" 
                                    BorderThickness="0" 
                                    Foreground="#FFFFFF" 
                                    FontWeight="SemiBold" 
                                    FontSize="12" 
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Open File"/>
                            </Button>

                            <!-- Open Folder (Secondary Clean) -->
                            <Button Grid.Column="1" 
                                    Command="{Binding OpenFolderCommand}" 
                                    Height="36" 
                                    Margin="4,0,0,0" 
                                    Background="{DynamicResource ButtonBackgroundBrush}" 
                                    BorderBrush="{DynamicResource ButtonBorderBrush}" 
                                    BorderThickness="1" 
                                    Foreground="{DynamicResource TextPrimaryBrush}" 
                                    FontWeight="SemiBold" 
                                    FontSize="12" 
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Open Folder"/>
                            </Button>
                        </Grid>

                        <!-- Bottom Icon Actions Row -->
                        <Border Grid.Row="4" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <UniformGrid Rows="1">
                                <Button Command="{Binding CopyUrlCommand}" ToolTip="Copy Link" Background="Transparent" BorderThickness="0" Cursor="Hand" Height="32">
                                    <TextBlock Text="🔗" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </Button>
                                <Button Command="{Binding RedownloadCommand}" ToolTip="Redownload" Background="Transparent" BorderThickness="0" Cursor="Hand" Height="32">
                                    <TextBlock Text="🔄" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </Button>
                                <Button Command="{Binding RemoveDownloadCommand}" ToolTip="Delete" Background="Transparent" BorderThickness="0" Cursor="Hand" Height="32">
                                    <TextBlock Text="🗑" FontSize="14" Foreground="#EF4444" HorizontalAlignment="Center"/>
                                </Button>
                                <Button Click="OverflowMenu_Click" ToolTip="More Options" Background="Transparent" BorderThickness="0" Cursor="Hand" Height="32">
                                    <TextBlock Text="···" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="📁 Open File" Command="{Binding OpenFileCommand}"/>
                                            <MenuItem Header="📂 Open Folder" Command="{Binding OpenFolderCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="🔗 Copy Source URL" Command="{Binding CopyUrlCommand}"/>
                                            <MenuItem Header="📂 Copy File Path" Command="{Binding CopySaveLocationCommand}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </UniformGrid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. BOTTOM APPLICATION STATUS BAR -->
            <Border Grid.Row="3" Background="{DynamicResource StatusBarBackgroundBrush}" BorderBrush="{DynamicResource StatusBarBorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <DockPanel LastChildFill="False" VerticalAlignment="Center">
                    <!-- Left: Metrics breakdown matching reference -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="📈" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        
                        <!-- Downloading count -->
                        <TextBlock Text="{Binding DownloadingCount, StringFormat='{}{0} downloading'}" 
                                   Foreground="#2563EB" 
                                   FontWeight="SemiBold" 
                                   FontSize="11" 
                                   VerticalAlignment="Center"/>
                        
                        <TextBlock Text="  |  " Foreground="{DynamicResource BorderColorBrush}" FontSize="11" VerticalAlignment="Center"/>

                        <!-- Queued count -->
                        <TextBlock Text="{Binding QueuedCount, StringFormat='{}{0} queued'}" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                   FontSize="11" 
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="  |  " Foreground="{DynamicResource BorderColorBrush}" FontSize="11" VerticalAlignment="Center"/>

                        <!-- Completed count -->
                        <TextBlock Text="{Binding CompletedCount, StringFormat='{}{0} completed'}" 
                                   Foreground="#10B981" 
                                   FontSize="11" 
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="  |  " Foreground="{DynamicResource BorderColorBrush}" FontSize="11" VerticalAlignment="Center"/>

                        <!-- Failed count -->
                        <TextBlock Text="{Binding FailedCount, StringFormat='{}{0} failed'}" 
                                   Foreground="#EF4444" 
                                   FontSize="11" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Aggregate Speed, Data Transferred & Scheduler -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <!-- Aggregate Transfer Speed -->
                        <TextBlock Text="🌐" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalSpeedFormatted}" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   FontSize="11" 
                                   Margin="0,0,16,0" 
                                   VerticalAlignment="Center"/>

                        <!-- Total Transferred / Overall Bytes -->
                        <TextBlock Text="{Binding TotalTransferredProgressFormatted}" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                   FontSize="11" 
                                   Margin="0,0,16,0" 
                                   VerticalAlignment="Center"/>

                        <!-- Scheduler Clock Icon -->
                        <TextBlock Text="🕒" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                   ToolTip="Queue Scheduler Active" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
