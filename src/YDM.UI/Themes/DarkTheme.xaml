<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Window & Layout Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0F19"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#273549"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="DetailsPanelBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SearchBoxBackgroundBrush" Color="#1E293B"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#475569"/>

    <!-- Borders & Dividers -->
    <SolidColorBrush x:Key="BorderColorBrush" Color="#334155"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#1E293B"/>

    <!-- Primary Accent (Blue) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="AccentSubtleBorderBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentSubtleTextBrush" Color="#93C5FD"/>

    <!-- Sidebar Active Selection -->
    <SolidColorBrush x:Key="SidebarActiveBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SidebarActiveTextBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="SidebarBadgeBackgroundBrush" Color="#334155"/>
    <SolidColorBrush x:Key="SidebarBadgeTextBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="SidebarActiveBadgeBackgroundBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="SidebarActiveBadgeTextBrush" Color="#FFFFFF"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="SuccessPillBackgroundBrush" Color="#064E3B"/>
    <SolidColorBrush x:Key="SuccessPillTextBrush" Color="#A7F3D0"/>
    
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarningPillBackgroundBrush" Color="#78350F"/>
    <SolidColorBrush x:Key="WarningPillTextBrush" Color="#FDE68A"/>

    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="ErrorPillBackgroundBrush" Color="#7F1D1D"/>
    <SolidColorBrush x:Key="ErrorPillTextBrush" Color="#FECACA"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#450A0A"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#991B1B"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FCA5A5"/>

    <!-- Progress Bars -->
    <SolidColorBrush x:Key="ProgressActiveBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="ProgressCompletedBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="ProgressBackgroundBrush" Color="#334155"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#334155"/>

    <!-- Interactive Buttons -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#334155"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#475569"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#334155"/>

    <!-- File Type Icon Badges -->
    <SolidColorBrush x:Key="BadgePdfBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="BadgeZipBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="BadgeExeBrush" Color="#475569"/>
    <SolidColorBrush x:Key="BadgeVideoBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="BadgeAudioBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="BadgeDocBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="BadgeGenericBrush" Color="#64748B"/>
</ResourceDictionary>
