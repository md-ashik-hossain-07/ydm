<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Window & Layout Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="DetailsPanelBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SearchBoxBackgroundBrush" Color="#F1F5F9"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#CBD5E1"/>

    <!-- Borders & Dividers -->
    <SolidColorBrush x:Key="BorderColorBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#F1F5F9"/>

    <!-- Primary Accent (Blue) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="AccentSubtleBorderBrush" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="AccentSubtleTextBrush" Color="#1D4ED8"/>

    <!-- Sidebar Active Selection -->
    <SolidColorBrush x:Key="SidebarActiveBackgroundBrush" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="SidebarActiveTextBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="SidebarBadgeBackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SidebarBadgeTextBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="SidebarActiveBadgeBackgroundBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="SidebarActiveBadgeTextBrush" Color="#FFFFFF"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessPillBackgroundBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="SuccessPillTextBrush" Color="#15803D"/>
    
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningPillBackgroundBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="WarningPillTextBrush" Color="#B45309"/>

    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="ErrorPillBackgroundBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="ErrorPillTextBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#B91C1C"/>

    <!-- Progress Bars -->
    <SolidColorBrush x:Key="ProgressActiveBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="ProgressCompletedBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="ProgressBackgroundBrush" Color="#E2E8F0"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#E2E8F0"/>

    <!-- Interactive Buttons -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#E2E8F0"/>

    <!-- File Type Icon Badges -->
    <SolidColorBrush x:Key="BadgePdfBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="BadgeZipBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="BadgeExeBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="BadgeVideoBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="BadgeAudioBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="BadgeDocBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="BadgeGenericBrush" Color="#94A3B8"/>
</ResourceDictionary>
