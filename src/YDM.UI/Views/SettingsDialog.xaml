<Window x:Class="YDM.UI.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YDM Settings" 
        Height="490" Width="580" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F3F3"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- Tab 1: General -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- Default Download Directory -->
                        <TextBlock Text="Default Download Folder:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button x:Name="BrowseFolderButton" Content="Browse..." Width="80" Height="28" DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowseFolderButton_Click"/>
                            <TextBox x:Name="DefaultFolderTextBox" Height="28" VerticalContentAlignment="Center"/>
                        </DockPanel>

                        <!-- Max Concurrent Downloads -->
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Max Simultaneous Downloads:" VerticalAlignment="Center" FontWeight="SemiBold" Width="220"/>
                            <TextBox x:Name="MaxConcurrentTextBox" Height="28" Width="70" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                        </DockPanel>

                        <!-- Default Connections per download -->
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Default Connections / File:" VerticalAlignment="Center" FontWeight="SemiBold" Width="220"/>
                            <TextBox x:Name="DefaultConnectionsTextBox" Height="28" Width="70" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                        </DockPanel>

                        <!-- Auto Start Downloads -->
                        <CheckBox x:Name="AutoStartCheckBox" Content="Auto-start queued downloads on application startup" Margin="0,6,0,8"/>

                        <!-- Allow Local IPs -->
                        <CheckBox x:Name="AllowLocalCheckBox" Content="Allow local network / private IP downloads (for testing and LAN)" Margin="0,4,0,8"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Appearance & Theme -->
            <TabItem Header="Appearance">
                <StackPanel Margin="16">
                    <TextBlock Text="Application Theme" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    <TextBlock Text="Choose whether YDM follows your Windows system theme or uses a fixed appearance." Foreground="#666666" Margin="0,0,0,12"/>
                    
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="Theme:" VerticalAlignment="Center" FontWeight="SemiBold" Width="100"/>
                        <ComboBox x:Name="ThemeComboBox" Width="160" Height="28" HorizontalAlignment="Left" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="System (Follow Windows)" IsSelected="True" Tag="System"/>
                            <ComboBoxItem Content="Light" Tag="Light"/>
                            <ComboBoxItem Content="Dark" Tag="Dark"/>
                        </ComboBox>
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <!-- Tab 3: Browser & Clipboard -->
            <TabItem Header="Integration">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Browser Download Interception" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock Text="Configure how Chrome and Microsoft Edge interact with YDM." Foreground="#666666" Margin="0,0,0,10"/>

                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="Interception Mode:" VerticalAlignment="Center" FontWeight="SemiBold" Width="150"/>
                            <ComboBox x:Name="InterceptionModeComboBox" Width="220" Height="28" HorizontalAlignment="Left" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Automatic (Hand off supported downloads)" IsSelected="True" Tag="Automatic"/>
                                <ComboBoxItem Content="Ask Before Download" Tag="Ask"/>
                                <ComboBoxItem Content="Manual Only (Context menu only)" Tag="Manual"/>
                            </ComboBox>
                        </DockPanel>

                        <Separator Margin="0,6,0,12"/>

                        <TextBlock Text="Clipboard &amp; Notifications" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ClipboardMonitoringCheckBox" Content="Monitor clipboard for downloadable URLs" Margin="0,4,0,8"/>
                        <TextBlock Text="When enabled, copying an HTTP/HTTPS file link displays a prompt to add it to YDM." Foreground="#777777" FontSize="11" Margin="20,0,0,12"/>

                        <CheckBox x:Name="NotificationsCheckBox" Content="Show Windows notifications when downloads complete or fail" Margin="0,4,0,8"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: Scheduler & History -->
            <TabItem Header="Queue &amp; Storage">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Queue Scheduler" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                        <CheckBox x:Name="QueueScheduleCheckBox" Content="Enable scheduled queue execution" Margin="0,4,0,8"/>

                        <DockPanel Margin="20,4,0,8">
                            <TextBlock Text="Start Queue At (HH:mm):" VerticalAlignment="Center" Width="160"/>
                            <TextBox x:Name="ScheduleStartTimeTextBox" Width="80" Height="26" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                        </DockPanel>

                        <DockPanel Margin="20,4,0,14">
                            <TextBlock Text="Stop Queue At (HH:mm):" VerticalAlignment="Center" Width="160"/>
                            <TextBox x:Name="ScheduleStopTimeTextBox" Width="80" Height="26" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                        </DockPanel>

                        <Separator Margin="0,6,0,12"/>

                        <TextBlock Text="File Deletion Confirmation" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ConfirmDeletionCheckBox" Content="Ask for confirmation before deleting downloaded files from disk" Margin="0,4,0,8"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Save and Cancel -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="Save Settings" Width="120" Height="34" Margin="0,0,10,0" Background="#0067C0" Foreground="White" FontWeight="SemiBold" Click="SaveButton_Click"/>
            <Button x:Name="CancelSettingsButton" Content="Cancel" Width="90" Height="34" IsCancel="True" Click="CancelSettingsButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
