<Window x:Class="YDM.UI.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YDM Settings" 
        Height="360" Width="520" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F3F3"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Default Download Directory -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Default Download Folder:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <TextBox x:Name="DefaultFolderTextBox" Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,5,5,5"/>
        <Button x:Name="BrowseFolderButton" Grid.Row="0" Grid.Column="2" Content="Browse..." Width="80" Height="30" Click="BrowseFolderButton_Click" Margin="0,5"/>

        <!-- Max Concurrent Downloads -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Max Simultaneous Downloads:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <TextBox x:Name="MaxConcurrentTextBox" Grid.Row="1" Grid.Column="1" Height="30" Width="80" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="0,5"/>

        <!-- Default Connections per download -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Default Connections / File:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <TextBox x:Name="DefaultConnectionsTextBox" Grid.Row="2" Grid.Column="1" Height="30" Width="80" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="0,5"/>

        <!-- Auto Start Downloads -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Auto-Start Queue:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <CheckBox x:Name="AutoStartCheckBox" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,10"/>

        <!-- Allow Local IPs -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Allow Local / LAN IPs:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <CheckBox x:Name="AllowLocalCheckBox" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,10"/>

        <!-- Save and Cancel -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="SaveButton" Content="Save Settings" Width="120" Height="34" Margin="0,0,10,0" Background="#0067C0" Foreground="White" FontWeight="SemiBold" Click="SaveButton_Click"/>
            <Button x:Name="CancelSettingsButton" Content="Cancel" Width="90" Height="34" IsCancel="True" Click="CancelSettingsButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
