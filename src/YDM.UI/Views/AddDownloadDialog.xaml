<Window x:Class="YDM.UI.Views.AddDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Download — YDM" 
        Height="410" Width="560" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F3F3"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- URL -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Download URL:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <TextBox x:Name="UrlTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Height="30" VerticalContentAlignment="Center" Margin="0,5"/>

        <!-- Destination Folder -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Save Folder:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <TextBox x:Name="FolderTextBox" Grid.Row="1" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,5,5,5"/>
        <Button x:Name="BrowseButton" Grid.Row="1" Grid.Column="2" Content="Browse..." Width="80" Height="30" Click="BrowseButton_Click" Margin="0,5"/>

        <!-- Set as Default Location -->
        <CheckBox x:Name="SetAsDefaultCheckBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Content="Set as default download location for future downloads" Margin="0,2,0,8"/>

        <!-- Filename Override -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="File Name (opt):" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <TextBox x:Name="FileNameTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Height="30" VerticalContentAlignment="Center" Margin="0,5"/>

        <!-- Max Connections -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Connections:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <ComboBox x:Name="ConnectionsComboBox" Grid.Row="4" Grid.Column="1" Height="30" Width="120" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="0,5">
            <ComboBoxItem Content="1 (Single)" />
            <ComboBoxItem Content="2" />
            <ComboBoxItem Content="4" />
            <ComboBoxItem Content="8 (Default)" IsSelected="True" />
            <ComboBoxItem Content="16" />
            <ComboBoxItem Content="32" />
        </ComboBox>

        <!-- Duplicate File Handling -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="If File Exists:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <ComboBox x:Name="DuplicateComboBox" Grid.Row="5" Grid.Column="1" Height="30" Width="150" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="0,5">
            <ComboBoxItem Content="Auto-Rename (1, 2...)" IsSelected="True" />
            <ComboBoxItem Content="Prompt for Action" />
            <ComboBoxItem Content="Overwrite Existing" />
        </ComboBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="DownloadNowButton" Content="Download Now" Width="120" Height="34" Margin="0,0,10,0" Background="#0067C0" Foreground="White" FontWeight="SemiBold" Click="DownloadNowButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="34" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
